{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/session_context.py\" --part 1", "timeout": 10},
          {"type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/session_context.py\" --part 2", "timeout": 10},
          {"type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/session_context.py\" --part 3", "timeout": 10},
          {"type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/session_context.py\" --part 4", "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {"matcher": "Agent|Task", "hooks": [{"type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/dispatch_guard.py\"", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/routing_audit.py\" --hook", "timeout": 30}]}
    ]
  }
}
